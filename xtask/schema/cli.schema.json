{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minibox.dev/schemas/xtask-cli.schema.json",
  "title": "cargo xtask CLI command schema",
  "description": "Machine-readable description of every `cargo xtask <command>` invocation accepted by xtask/src/main.rs. Each branch of the root `oneOf` corresponds to one match arm in `main()`. Generated by hand from source (xtask/src/main.rs) — regenerate manually when main.rs's match arms change; there is no build-time codegen for this file.",
  "type": "object",
  "required": ["command"],
  "oneOf": [
    { "$ref": "#/$defs/commands/test" },
    { "$ref": "#/$defs/commands/check" },
    { "$ref": "#/$defs/commands/docs" },
    { "$ref": "#/$defs/commands/info" },

    { "$ref": "#/$defs/commands/verify" },
    { "$ref": "#/$defs/commands/lint" },
    { "$ref": "#/$defs/commands/fix" },
    { "$ref": "#/$defs/commands/pre-commit" },
    { "$ref": "#/$defs/commands/prepush" },
    { "$ref": "#/$defs/commands/musl-check" },
    { "$ref": "#/$defs/commands/agentlint" },
    { "$ref": "#/$defs/commands/coverage" },
    { "$ref": "#/$defs/commands/coverage-check" },
    { "$ref": "#/$defs/commands/architecture" },

    { "$ref": "#/$defs/commands/build-test-image" },
    { "$ref": "#/$defs/commands/setup-test-vm" },
    { "$ref": "#/$defs/commands/test-in-vm" },
    { "$ref": "#/$defs/commands/test-linux" },

    { "$ref": "#/$defs/commands/clean-artifacts" },
    { "$ref": "#/$defs/commands/nuke-test-state" },

    { "$ref": "#/$defs/commands/bump" },
    { "$ref": "#/$defs/commands/preflight" },
    { "$ref": "#/$defs/commands/doctor" },
    { "$ref": "#/$defs/commands/available" },
    { "$ref": "#/$defs/commands/promote" },
    { "$ref": "#/$defs/commands/ci-watch" },
    { "$ref": "#/$defs/commands/daily-orchestration" },
    { "$ref": "#/$defs/commands/council" },

    { "$ref": "#/$defs/commands/bench" },
    { "$ref": "#/$defs/commands/fuzz" },
    { "$ref": "#/$defs/commands/demo" },
    { "$ref": "#/$defs/commands/borrow-fixtures" },
    { "$ref": "#/$defs/commands/clippy-sarif" },
    { "$ref": "#/$defs/commands/run-cgroup-tests" },
    { "$ref": "#/$defs/commands/cas-add" },
    { "$ref": "#/$defs/commands/cas-check" },
    { "$ref": "#/$defs/commands/lint-paths" },
    { "$ref": "#/$defs/commands/run" }
  ],
  "$defs": {
    "commands": {
      "test": {
        "type": "object",
        "description": "Run a test suite. `cargo xtask test <suite>`. Bare `cargo xtask test` prints the suite list and exits 0.",
        "properties": {
          "command": { "const": "test" },
          "args": {
            "type": "object",
            "properties": {
              "suite": {
                "enum": [
                  "unit", "conformance", "krun-conformance", "turmoil", "shuttle",
                  "property", "quickcheck", "integration", "e2e", "system-suite",
                  "e2e-suite", "sandbox", "gke-profile", "gke-adapter", "cgroup"
                ],
                "description": "e2e-suite and system-suite are the same target (dispatch_test treats them identically)."
              }
            },
            "required": []
          }
        },
        "required": ["command"],
        "deprecatedAliases": [
          "test-unit", "test-conformance", "test-krun-conformance", "test-turmoil",
          "test-shuttle", "test-property", "test-quickcheck", "test-integration",
          "test-e2e", "test-system-suite", "test-e2e-suite", "test-sandbox",
          "test-gke-profile", "test-gke-adapter"
        ]
      },
      "check": {
        "type": "object",
        "description": "Static checks. `cargo xtask check <target> [flags...]`. Bare `cargo xtask check` prints the target list.",
        "properties": {
          "command": { "const": "check" },
          "args": {
            "type": "object",
            "properties": {
              "target": {
                "enum": [
                  "stale-names", "protocol-drift", "protocol-sites",
                  "protocol-variants", "adapter-coverage", "no-unwrap", "repo-clean"
                ]
              },
              "update": { "type": "boolean", "default": false, "appliesTo": ["protocol-drift"], "description": "Write current hashes into xtask/protocol-drift.lock instead of comparing." },
              "warn_only": { "type": "boolean", "default": false, "appliesTo": ["protocol-drift", "protocol-sites"], "description": "Print drift/mismatch but exit 0." },
              "hook": { "type": "boolean", "default": false, "appliesTo": ["protocol-drift"], "description": "Read tool_input.file_path from stdin (Claude Code PostToolUse hook JSON) and only check if that path is a tracked surface." },
              "sarif": { "type": "string", "format": "path", "appliesTo": ["protocol-drift"], "description": "Write a SARIF report to this path in addition to normal output." },
              "file": { "type": "string", "format": "path", "default": "crates/miniboxd/src/main.rs", "appliesTo": ["protocol-sites"], "description": "File to scan for HandlerDependencies construction sites." },
              "expected": { "type": "integer", "default": 4, "appliesTo": ["protocol-sites"], "description": "Expected construction-site count." },
              "strict": { "type": "boolean", "default": false, "appliesTo": ["no-unwrap"], "description": "Exit non-zero if any .unwrap() calls are found outside test infrastructure. Without --strict, findings are printed as a warning and the command exits 0." }
            }
          }
        },
        "required": ["command"],
        "deprecatedAliases": [
          "check-stale-names", "check-protocol-drift", "check-protocol-sites",
          "check-adapter-coverage", "check-no-unwrap", "check-repo-clean"
        ]
      },
      "docs": {
        "type": "object",
        "description": "Documentation tools. `cargo xtask docs <action> [flags...]`. Bare `cargo xtask docs` prints the action list.",
        "properties": {
          "command": { "const": "docs" },
          "args": {
            "type": "object",
            "properties": {
              "action": { "enum": ["audit", "lint", "update-date", "sync-adapters"] },
              "full": { "type": "boolean", "default": false, "appliesTo": ["audit"], "description": "Full audit mode instead of Quick; rewrites the tracked xtask/docs-audit-report.json report." },
              "strict": { "type": "boolean", "default": false, "appliesTo": ["audit"], "description": "Only meaningful in Quick mode (ignored when --full is set)." },
              "sarif": { "type": "string", "format": "path", "appliesTo": ["lint"], "description": "Write a SARIF report of frontmatter/status violations." }
            }
          }
        },
        "required": ["command"],
        "deprecatedAliases": ["docs-audit", "lint-docs", "update-feature-matrix-date"]
      },
      "info": {
        "type": "object",
        "description": "Introspection. `cargo xtask info <target> [flags...]`. Bare `cargo xtask info` prints the target list.",
        "outputSchema": { "$ref": "#/$defs/contextSnapshot" },
        "properties": {
          "command": { "const": "info" },
          "args": {
            "type": "object",
            "properties": {
              "target": { "enum": ["metrics", "context", "changes"] },
              "save": { "type": "boolean", "default": false, "appliesTo": ["metrics", "context"], "description": "Persist the validated snapshot; context JSON is always printed first." },
              "strict": { "type": "boolean", "default": false, "appliesTo": ["context"], "description": "After emitting JSON, exit non-zero when required validation evidence or blocking diagnostics are missing." },
              "validate_all": { "type": "boolean", "default": false, "appliesTo": ["context"], "description": "Attempt every configured validation profile instead of only the native host profile." },
              "evidence_dir": { "type": "string", "format": "path", "appliesTo": ["context"], "description": "Import exact-cache-key profile evidence; stale evidence remains diagnostic-only." },
              "base_ref": { "type": "string", "default": "HEAD^", "appliesTo": ["changes"], "description": "Git ref to diff against. Emits GitHub Actions step outputs classifying changed paths." }
            }
          }
        },
        "required": ["command"],
        "deprecatedAliases": ["collect-metrics", "context", "detect-changes"]
      },

      "verify": {
        "type": "object",
        "description": "Read-only local gate: fmt --check, cargo check --workspace, clippy -D warnings, borrow-reasoning fixtures, docs lint. Never mutates files. Checkpointed (skipped if tree hash unchanged since last pass).",
        "properties": { "command": { "const": "verify" } },
        "required": ["command"],
        "mutatesWorkspace": false
      },
      "lint": {
        "type": "object",
        "description": "fmt --check + clippy -D warnings + cargo check --workspace across the full adapter matrix. Checkpointed.",
        "properties": { "command": { "const": "lint" } },
        "required": ["command"],
        "mutatesWorkspace": false
      },
      "fix": {
        "type": "object",
        "description": "Mutating: cargo fmt --all, git add -u, version bump, clippy --fix --allow-dirty --allow-staged, git add -u again. Only runs if Rust files are staged.",
        "properties": { "command": { "const": "fix" } },
        "required": ["command"],
        "mutatesWorkspace": true
      },
      "pre-commit": {
        "type": "object",
        "description": "Pre-commit gate: formats and re-stages staged Rust, runs clippy and architecture checks, validates agent/workflow/docs files, updates the FEATURE_MATRIX date stamp, and reports repository cleanliness. Never runs release build or conformance.",
        "properties": { "command": { "const": "pre-commit" } },
        "required": ["command"],
        "mutatesWorkspace": true
      },
      "prepush": {
        "type": "object",
        "description": "Release build (miniboxd, minibox-core, mbx, minibox, minibox-macros) + nextest (release profile) + conformance suite. Skipped entirely if no Rust files are in the push range. Checkpointed.",
        "properties": { "command": { "const": "prepush" } },
        "required": ["command"],
        "mutatesWorkspace": false
      },
      "musl-check": {
        "type": "object",
        "description": "Cross-build miniboxd and minibox-cli for x86_64-unknown-linux-musl. Warns and skips when prerequisites are unavailable unless MINIBOX_REQUIRE_MUSL_CHECK=1.",
        "properties": { "command": { "const": "musl-check" } },
        "required": ["command"],
        "mutatesWorkspace": false
      },
      "agentlint": {
        "type": "object",
        "description": "Lint agent config files (.claude/, .codex/, .agents/, .cursor/).",
        "properties": {
          "command": { "const": "agentlint" },
          "args": {
            "type": "object",
            "properties": {
              "all": { "type": "boolean", "default": false, "description": "Lint every agent config file in the repo instead of only staged ones." }
            }
          }
        },
        "required": ["command"]
      },
      "coverage": {
        "type": "object",
        "description": "Generate a coverage report (lcov and/or HTML).",
        "properties": {
          "command": { "const": "coverage" },
          "args": {
            "type": "object",
            "properties": {
              "open": { "type": "boolean", "default": false, "description": "Open the HTML report after generating it." },
              "lcov_only": { "type": "boolean", "default": false },
              "html_only": { "type": "boolean", "default": false }
            }
          }
        },
        "required": ["command"]
      },
      "coverage-check": {
        "type": "object",
        "description": "Handler module function coverage gate.",
        "properties": { "command": { "const": "coverage-check" } },
        "required": ["command"]
      },
      "architecture": {
        "type": "object",
        "description": "Validate workspace dependency rings and canonical crate ownership without modifying files.",
        "properties": { "command": { "const": "architecture" } },
        "required": ["command"],
        "mutatesWorkspace": false
      },

      "build-test-image": {
        "type": "object",
        "description": "Cross-compile the test binaries and package an OCI tarball for VM-based testing.",
        "properties": {
          "command": { "const": "build-test-image" },
          "args": { "type": "object", "properties": { "force": { "type": "boolean", "default": false, "description": "Rebuild even if a cached image already exists." } } }
        },
        "required": ["command"]
      },
      "setup-test-vm": {
        "type": "object",
        "description": "Build/refresh a persistent smolvm VM with a Rust toolchain, for macOS-side testing.",
        "properties": {
          "command": { "const": "setup-test-vm" },
          "args": { "type": "object", "properties": { "force": { "type": "boolean", "default": false } } }
        },
        "required": ["command"]
      },
      "test-in-vm": {
        "type": "object",
        "description": "Dual-backend (native minibox + smolvm) test run inside a VM.",
        "properties": {
          "command": { "const": "test-in-vm" },
          "args": {
            "type": "object",
            "properties": {
              "skip_build": { "type": "boolean", "default": false },
              "keep": { "type": "boolean", "default": false, "description": "Keep the VM/container after the run instead of tearing it down." },
              "smolfile": { "type": "string", "format": "path", "description": "Alternate Smolfile path." }
            }
          }
        },
        "required": ["command"]
      },
      "test-linux": {
        "type": "object",
        "description": "Cross-compile (zigbuild), build a CPIO initramfs, and run tests inside a smolvm QEMU VM against the cross-compiled binaries. No flags — all configuration comes from xtask/xconfig (XConfig::load).",
        "properties": { "command": { "const": "test-linux" } },
        "required": ["command"]
      },

      "clean-artifacts": {
        "type": "object",
        "description": "Remove non-critical build outputs.",
        "properties": { "command": { "const": "clean-artifacts" } },
        "required": ["command"]
      },
      "nuke-test-state": {
        "type": "object",
        "description": "Kill orphaned test processes, unmount leaked overlay mounts, and remove stale cgroups/temp state. Safe cleanup for a machine with accumulated test cruft.",
        "properties": { "command": { "const": "nuke-test-state" } },
        "required": ["command"]
      },

      "bump": {
        "type": "object",
        "description": "Bump the workspace version.",
        "properties": {
          "command": { "const": "bump" },
          "args": {
            "type": "object",
            "properties": {
              "level": { "enum": ["patch", "minor", "major"], "default": "patch" },
              "changelog": { "type": "boolean", "default": false, "description": "Render release notes with git-cliff and update Cargo.toml and CHANGELOG.md transactionally." }
            }
          }
        },
        "required": ["command"]
      },
      "preflight": {
        "type": "object",
        "description": "Verify required tools are on PATH (cargo, cargo-nextest, gh).",
        "properties": { "command": { "const": "preflight" } },
        "required": ["command"]
      },
      "doctor": {
        "type": "object",
        "description": "Full preflight diagnostics (compiled adapters, capability probes) — same underlying probe as `mbx doctor`.",
        "properties": { "command": { "const": "doctor" } },
        "required": ["command"]
      },
      "available": {
        "type": "object",
        "description": "Check whether the xtask binary itself is available/buildable. Undocumented: not listed in print_help(), but reachable as a top-level match arm.",
        "properties": { "command": { "const": "available" } },
        "required": ["command"]
      },
      "promote": {
        "type": "object",
        "description": "Cascade-merge stability tiers (develop -> staging -> release -> main), gated on CI green for each source branch.",
        "properties": {
          "command": { "const": "promote" },
          "args": {
            "type": "object",
            "properties": {
              "from": { "enum": ["develop", "staging", "release", "main"], "default": "develop" },
              "to": { "enum": ["develop", "staging", "release", "main"], "default": "main" },
              "dry_run": { "type": "boolean", "default": false, "description": "Print the cascade plan without merging." },
              "skip_ci_check": { "type": "boolean", "default": false, "description": "Skip source-branch GitHub Actions checks." }
            }
          }
        },
        "required": ["command"]
      },
      "ci-watch": {
        "type": "object",
        "description": "Watch the most recent GitHub Actions run with job-level detail.",
        "properties": {
          "command": { "const": "ci-watch" },
          "args": { "type": "object", "properties": { "branch": { "type": "string", "description": "Defaults to the current branch." } } }
        },
        "required": ["command"]
      },
      "daily-orchestration": {
        "type": "object",
        "description": "Run the daily maintenance orchestration pass.",
        "properties": {
          "command": { "const": "daily-orchestration" },
          "args": {
            "type": "object",
            "properties": {
              "ci": { "type": "boolean", "default": false },
              "dry_run": { "type": "boolean", "default": false }
            }
          }
        },
        "required": ["command"],
        "notes": "Unrecognized flags other than --ci/--dry-run cause a usage error (unlike most other xtask parsers, which just warn and ignore)."
      },
      "council": {
        "type": "object",
        "description": "Run devloop council analysis against a base ref.",
        "properties": {
          "command": { "const": "council" },
          "args": {
            "type": "object",
            "properties": {
              "base": { "type": "string", "default": "main" },
              "mode": { "enum": ["core", "extended"], "default": "core" },
              "no_synthesis": { "type": "boolean", "default": false },
              "prod": { "type": "boolean", "default": false }
            }
          }
        },
        "required": ["command"]
      },

      "bench": {
        "type": "object",
        "description": "Run Criterion benchmarks and save results to bench/results/.",
        "properties": {
          "command": { "const": "bench" },
          "args": {
            "type": "object",
            "properties": {
              "skip_bench": { "type": "boolean", "default": false },
              "check": { "type": "boolean", "default": false, "description": "Regression-check mode: compare against a saved baseline instead of running+saving." },
              "save_baseline": { "type": "boolean", "default": false },
              "threshold": { "type": "number", "default": 15.0, "description": "Regression threshold percentage." },
              "env": { "type": "string", "default": "local", "description": "Environment label used to select/save the correct baseline file." }
            }
          }
        },
        "required": ["command"],
        "notes": "Unrecognized flags produce a warning and are ignored, not a hard error."
      },
      "fuzz": {
        "type": "object",
        "description": "Run libFuzzer protocol targets.",
        "properties": { "command": { "const": "fuzz" } },
        "required": ["command"]
      },
      "demo": {
        "type": "object",
        "description": "Short end-to-end demonstration: pull + run against the named adapter. Exits 0 even on command failure (advisory).",
        "properties": {
          "command": { "const": "demo" },
          "args": {
            "type": "object",
            "properties": {
              "adapter": { "type": "string", "default": "smolvm" },
              "filter": { "type": "string", "description": "Run only showcase scenarios whose names contain this value." },
              "strict": { "type": "boolean", "default": false, "description": "Exit non-zero when a showcase command fails." }
            }
          }
        },
        "required": ["command"]
      },
      "borrow-fixtures": {
        "type": "object",
        "description": "Run borrow-reasoning must-pass/must-fail fixtures (compile-time checks that specific borrow patterns do/don't compile).",
        "properties": { "command": { "const": "borrow-fixtures" } },
        "required": ["command"]
      },
      "clippy-sarif": {
        "type": "object",
        "description": "Run clippy and write results as a SARIF report.",
        "properties": {
          "command": { "const": "clippy-sarif" },
          "args": { "type": "object", "properties": { "path": { "type": "string", "format": "path", "default": "clippy.sarif" } } }
        },
        "required": ["command"]
      },
      "run-cgroup-tests": {
        "type": "object",
        "description": "cgroup v2 integration tests (Linux, root).",
        "properties": { "command": { "const": "run-cgroup-tests" } },
        "required": ["command"]
      },
      "cas-add": {
        "type": "object",
        "description": "Add a file to the content-addressed overlay store.",
        "properties": {
          "command": { "const": "cas-add" },
          "args": {
            "type": "object",
            "properties": {
              "file": { "type": "string", "format": "path" },
              "ref": { "type": "string", "description": "Named reference to attach to the stored object." }
            },
            "required": ["file"]
          }
        },
        "required": ["command", "args"]
      },
      "cas-check": {
        "type": "object",
        "description": "Verify overlay refs match their CAS objects.",
        "properties": { "command": { "const": "cas-check" } },
        "required": ["command"]
      },
      "lint-paths": {
        "type": "object",
        "description": "Lint path-handling code. Undocumented: not listed in print_help(), but reachable as a top-level match arm.",
        "properties": { "command": { "const": "lint-paths" } },
        "required": ["command"]
      },
      "run": {
        "type": "object",
        "description": "Run a Nushell script from scripts/<name>.nu, forwarding remaining args. Errors with the available script list if the named script doesn't exist.",
        "properties": {
          "command": { "const": "run" },
          "args": {
            "type": "object",
            "properties": {
              "script": { "type": "string", "description": "Script name without the .nu extension." },
              "extra_args": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["script"]
          }
        },
        "required": ["command", "args"]
      }
    },
    "contextSnapshot": {
      "type": "object",
      "description": "Output contract for cargo xtask info context v3.",
      "additionalProperties": false,
      "required": ["snapshot_version", "identity", "environment", "workspace", "adapters", "tests", "context_map", "evidence", "diagnostics"],
      "properties": {
        "snapshot_version": { "const": 3 },
        "identity": { "$ref": "#/$defs/repositoryIdentity" },
        "environment": { "$ref": "#/$defs/environmentSnapshot" },
        "workspace": { "$ref": "#/$defs/workspaceSnapshot" },
        "adapters": { "type": "array", "items": { "$ref": "#/$defs/adapterSnapshot" } },
        "tests": { "$ref": "#/$defs/testSnapshot" },
        "context_map": { "$ref": "#/$defs/contextMap" },
        "evidence": { "type": "object", "additionalProperties": { "$ref": "#/$defs/evidence" } },
        "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/contextDiagnostic" } }
      }
    },
    "repositoryPath": { "type": "string", "minLength": 1 },
    "evidenceIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": { "enum": ["match", "mismatch", "declared_only", "observed_only", "unavailable"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "factString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "validation", "evidence_ids"],
      "properties": {
        "declared": { "type": ["string", "null"] },
        "observed": { "type": ["string", "null"] },
        "validation": { "$ref": "#/$defs/validation" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "factStringArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "validation", "evidence_ids"],
      "properties": {
        "declared": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "observed": { "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }] },
        "validation": { "$ref": "#/$defs/validation" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "factBoolean": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "validation", "evidence_ids"],
      "properties": {
        "declared": { "type": ["boolean", "null"] },
        "observed": { "type": ["boolean", "null"] },
        "validation": { "$ref": "#/$defs/validation" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "factMaturity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "validation", "evidence_ids"],
      "properties": {
        "declared": { "anyOf": [{ "enum": ["production", "experimental", "stub", "blocked"] }, { "type": "null" }] },
        "observed": { "anyOf": [{ "enum": ["production", "experimental", "stub", "blocked"] }, { "type": "null" }] },
        "validation": { "$ref": "#/$defs/validation" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "factCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "observed", "validation", "evidence_ids"],
      "properties": {
        "declared": { "anyOf": [{ "enum": ["yes", "limited", "blocked", "no"] }, { "type": "null" }] },
        "observed": { "anyOf": [{ "enum": ["yes", "limited", "blocked", "no"] }, { "type": "null" }] },
        "validation": { "$ref": "#/$defs/validation" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "repositoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch", "dirty", "changed_paths", "worktree_fingerprint", "evidence_ids"],
      "properties": {
        "commit": { "type": "string" },
        "branch": { "type": "string" },
        "dirty": { "type": "boolean" },
        "changed_paths": { "type": "array", "items": { "$ref": "#/$defs/repositoryPath" } },
        "worktree_fingerprint": { "type": "string" },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "environmentSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "target", "enabled_features", "rustc_version", "cargo_version", "nextest_version", "generated_at"],
      "properties": {
        "host": { "type": "string" },
        "target": { "type": "string" },
        "enabled_features": { "type": "array", "items": { "type": "string" } },
        "rustc_version": { "$ref": "#/$defs/factString" },
        "cargo_version": { "$ref": "#/$defs/factString" },
        "nextest_version": { "$ref": "#/$defs/factString" },
        "generated_at": { "type": "string" }
      }
    },
    "workspaceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "edition", "msrv", "packages"],
      "properties": {
        "version": { "$ref": "#/$defs/factString" },
        "edition": { "$ref": "#/$defs/factString" },
        "msrv": { "$ref": "#/$defs/factString" },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/packageSnapshot" } }
      }
    },
    "packageSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "name", "manifest_path", "targets", "features", "dependencies", "metrics"],
      "properties": {
        "package_id": { "type": "string" },
        "name": { "type": "string" },
        "manifest_path": { "$ref": "#/$defs/repositoryPath" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/targetSnapshot" } },
        "features": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependencySnapshot" } },
        "metrics": { "$ref": "#/$defs/sourceMetrics" }
      }
    },
    "targetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kinds", "source_path", "required_features"],
      "properties": {
        "name": { "type": "string" },
        "kinds": { "type": "array", "items": { "type": "string" } },
        "source_path": { "$ref": "#/$defs/repositoryPath" },
        "required_features": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dependencySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_name", "rename", "kind", "target_predicate", "optional"],
      "properties": {
        "package_name": { "type": "string" },
        "rename": { "type": ["string", "null"] },
        "kind": { "enum": ["normal", "build", "dev"] },
        "target_predicate": { "type": ["string", "null"] },
        "optional": { "type": "boolean" }
      }
    },
    "sourceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust_files", "physical_lines", "non_empty_lines", "included_roots", "includes_generated"],
      "properties": {
        "rust_files": { "type": "integer", "minimum": 0 },
        "physical_lines": { "type": "integer", "minimum": 0 },
        "non_empty_lines": { "type": "integer", "minimum": 0 },
        "included_roots": { "type": "array", "items": { "$ref": "#/$defs/repositoryPath" } },
        "includes_generated": { "type": "boolean" }
      }
    },
    "adapterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "maturity", "platforms", "default_roles", "registry_presence", "capabilities"],
      "properties": {
        "id": { "type": "string" },
        "maturity": { "$ref": "#/$defs/factMaturity" },
        "platforms": { "$ref": "#/$defs/factStringArray" },
        "default_roles": { "$ref": "#/$defs/factStringArray" },
        "registry_presence": { "$ref": "#/$defs/factBoolean" },
        "capabilities": { "type": "object", "additionalProperties": { "$ref": "#/$defs/factCapability" } }
      }
    },
    "testSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_declarations", "profiles", "validated_unique_tests"],
      "properties": {
        "source_declarations": { "type": "array", "items": { "$ref": "#/$defs/sourceTestDeclaration" } },
        "profiles": { "type": "array", "items": { "$ref": "#/$defs/testProfileResult" } },
        "validated_unique_tests": { "type": "array", "items": { "$ref": "#/$defs/executableTest" } }
      }
    },
    "sourceTestDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "package_id", "path", "module_path", "name", "cfg_predicates", "kind"],
      "properties": {
        "stable_id": { "type": "string" },
        "package_id": { "type": "string" },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "module_path": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "cfg_predicates": { "type": "array", "items": { "type": "string" } },
        "kind": { "enum": ["function", "macro_invocation"] }
      }
    },
    "testProfileResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "target", "features", "status", "executable_tests", "unavailable_reason", "evidence_ids"],
      "properties": {
        "profile_id": { "type": "string" },
        "target": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["validated", "failed", "unavailable", "stale"] },
        "executable_tests": { "type": "array", "items": { "$ref": "#/$defs/executableTest" } },
        "unavailable_reason": { "type": ["string", "null"] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "executableTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id", "package_id", "binary_id", "test_name", "ignored"],
      "properties": {
        "stable_id": { "type": "string" },
        "package_id": { "type": "string" },
        "binary_id": { "type": "string" },
        "test_name": { "type": "string" },
        "ignored": { "type": "boolean" }
      }
    },
    "contextMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crates", "files", "changed_files", "collector_tasks"],
      "properties": {
        "crates": { "type": "array", "items": { "$ref": "#/$defs/crateOwnership" } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/fileOwnership" } },
        "changed_files": { "type": "array", "items": { "$ref": "#/$defs/fileOwnership" } },
        "collector_tasks": { "type": "array", "items": { "$ref": "#/$defs/collectorTask" } }
      }
    },
    "crateOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "manifest_path", "source_roots", "evidence_ids"],
      "properties": {
        "package_id": { "type": "string" },
        "manifest_path": { "$ref": "#/$defs/repositoryPath" },
        "source_roots": { "type": "array", "items": { "$ref": "#/$defs/repositoryPath" } },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "fileOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "owner_package_id", "role", "role_origin", "evidence_ids"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "owner_package_id": { "type": ["string", "null"] },
        "role": { "enum": ["cargo_target", "rust_source", "test", "example", "benchmark", "manifest", "documentation", "workflow", "configuration", "other"] },
        "role_origin": { "enum": ["cargo_metadata", "declared_rule", "inferred_path"] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "collectorTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "depends_on", "status", "evidence_ids"],
      "properties": {
        "id": { "type": "string" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["collected", "failed", "stale", "unavailable"] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "collected_at", "content_sha256", "profile_id", "status"],
      "properties": {
        "kind": { "enum": ["cargo_metadata", "git", "manifest", "nextest", "rust_source", "tool_version", "ci_artifact"] },
        "locator": { "type": "string" },
        "collected_at": { "type": "string" },
        "content_sha256": { "type": ["string", "null"] },
        "profile_id": { "type": ["string", "null"] },
        "status": { "enum": ["collected", "failed", "stale", "unavailable"] }
      }
    },
    "contextDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "profile_id", "evidence_ids"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "profile_id": { "type": ["string", "null"] },
        "evidence_ids": { "$ref": "#/$defs/evidenceIds" }
      }
    }
  }
}
