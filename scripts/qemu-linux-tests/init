#!/bin/sh
# init for the qemu-linux-tests harness.
#
# Replaces the stock Alpine initramfs init in a *copy* of the initramfs so the
# statically-linked minibox lib test binary can run on a real aarch64 Linux
# kernel without switch_root, apk, or networking.
#
# The test filter and binary name are read from the kernel command line, so
# changing what runs does not require repacking:
#
#   console=ttyAMA0 mbx_filter=<substring> mbx_bin=/mbx-test
#
# An empty/absent mbx_filter runs the whole suite.

halt() {
	echo ""
	echo "harness done"
	sync
	echo o > /proc/sysrq-trigger 2>/dev/null
	sleep 5
	poweroff -f 2>/dev/null
	# Deliberately no infinite loop here. If the guest cannot power itself off,
	# returning lets the kernel panic on the dead init, and QEMU's -no-reboot
	# then exits. Looping forever instead would hang the harness silently.
	sleep 10
}

/bin/busybox mkdir -p /proc /sys /dev /tmp /bin /sbin
/bin/busybox --install -s
export PATH="/bin:/sbin:/usr/bin:/usr/sbin"

mount -t proc -o noexec,nosuid,nodev proc /proc
mount -t sysfs -o noexec,nosuid,nodev sysfs /sys
mount -t devtmpfs -o exec,nosuid,mode=0755,size=2M devtmpfs /dev 2>/dev/null \
	|| mount -t tmpfs -o exec,nosuid,mode=0755,size=2M tmpfs /dev
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
mkdir -p /dev/shm
mount -t tmpfs -o nodev,nosuid,noexec shm /dev/shm

# Read mbx_filter / mbx_bin off the kernel cmdline.
FILTER=""
BIN=/mbx-test
for opt in $(cat /proc/cmdline); do
	case "$opt" in
	mbx_filter=*) FILTER="${opt#mbx_filter=}" ;;
	mbx_bin=*)    BIN="${opt#mbx_bin=}" ;;
	esac
done

echo "=========================================================="
echo " minibox linux tests (qemu harness)"
echo "   kernel:  $(uname -r)"
echo "   arch:    $(uname -m)"
echo "   uid:     $(id -u)"
echo "   filter:  ${FILTER:-<none: whole suite>}"
echo "=========================================================="

if [ ! -x "$BIN" ]; then
	echo "FATAL: $BIN not found or not executable"
	ls -la /
	halt
fi

if [ -n "$FILTER" ]; then
	"$BIN" --test-threads=1 -- "$FILTER" 2>&1
else
	"$BIN" --test-threads=4 2>&1
fi

halt
