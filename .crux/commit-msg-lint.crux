pipeline: minibox_commit_msg_lint
# Validate a commit message follows conventional-commit format.
# Input: { "msg_file": ".git/COMMIT_EDITMSG" }
# Run via git commit-msg hook: crux run .crux/commit-msg-lint.crux input.json
# Default: reads .git/COMMIT_EDITMSG
budget: { calls: 4 }

steps:
  - step: read_msg
    handler: shell::capture
    args:
      cmd: "head -1 .git/COMMIT_EDITMSG"

  - step: check_format
    handler: shell::capture
    args:
      cmd: >-
        MSG=$(head -1 .git/COMMIT_EDITMSG);
        echo "$MSG" |
        grep -qE '^(feat|fix|docs|chore|refactor|test|style|ci|perf|revert)(\(.+\))?: .{1,72}$'
        && echo "ok: $MSG" || (echo "commit-msg: does not match conventional commit format: $MSG" >&2; exit 1)
