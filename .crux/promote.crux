pipeline: minibox_promote
# Cascade promotion through the stability pipeline:
# develop -> next -> staging -> main.
#
# Runs tiered quality gates, then creates PRs for each hop.
# Protected branches require PRs with passing status checks,
# so direct merge+push is not possible.
#
# Tier gates:
#   dev     : lint, test-unit
#   testing : test-conformance, test-property, borrow-fixtures
#   staging : prepush, coverage-check
#   main    : check-no-unwrap, check-protocol-drift, lint-docs
#
# Run: crux run .crux/promote.crux
budget: { calls: 20 }

steps:
  # --- Dev tier gates ---
  - step: gate_lint
    handler: shell::exec
    args:
      cmd: "cargo xtask lint"

  - step: gate_test_unit
    handler: shell::exec
    args:
      cmd: "cargo xtask test-unit"

  # --- Testing tier gates ---
  - step: gate_test_conformance
    handler: shell::exec
    args:
      cmd: "cargo xtask test-conformance"

  - step: gate_test_property
    handler: shell::exec
    args:
      cmd: "cargo xtask test-property"

  - step: gate_borrow_fixtures
    handler: shell::exec
    args:
      cmd: "cargo xtask borrow-fixtures"

  # --- Staging tier gates ---
  - step: gate_prepush
    handler: shell::exec
    args:
      cmd: "cargo xtask prepush"

  - step: gate_coverage_check
    handler: shell::exec
    args:
      cmd: "cargo xtask coverage-check"

  # --- Main tier gates ---
  - step: gate_check_protocol_drift
    handler: shell::exec
    args:
      cmd: "cargo xtask check-protocol-drift"

  - step: gate_lint_docs
    handler: shell::exec
    args:
      cmd: "cargo xtask lint-docs"

  # --- Create or update promotion PRs ---
  - step: pr_develop_to_next
    handler: shell::exec
    args:
      cmd: |
        existing=$(gh pr list --base next --head develop --state open --json number -q '.[0].number')
        if [ -n "$existing" ]; then
          echo "PR #$existing already open: develop -> next"
        else
          gh pr create --base next --head develop \
            --title "Promote develop -> next" \
            --body "Automated promotion. All local gates passed."
        fi

  - step: pr_next_to_staging
    handler: shell::exec
    args:
      cmd: |
        existing=$(gh pr list --base staging --head next --state open --json number -q '.[0].number')
        if [ -n "$existing" ]; then
          echo "PR #$existing already open: next -> staging"
        else
          gh pr create --base staging --head next \
            --title "Promote next -> staging" \
            --body "Automated promotion. All local gates passed."
        fi

  - step: pr_staging_to_main
    handler: shell::exec
    args:
      cmd: |
        existing=$(gh pr list --base main --head staging --state open --json number -q '.[0].number')
        if [ -n "$existing" ]; then
          echo "PR #$existing already open: staging -> main"
        else
          gh pr create --base main --head staging \
            --title "Promote staging -> main" \
            --body "Automated promotion. All local gates passed."
        fi

  - step: done
    handler: ctrl::log
    args:
      msg: "Promotion PRs created: develop->next, next->staging, staging->main"
