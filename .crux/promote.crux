pipeline: minibox_promote
# Cascade promotion through the stability pipeline:
# develop -> staging -> release -> main.
#
# Each tier runs its gates, builds the release binaries, then advances to
# the next branch. Container smoke tests are NOT run here: they need root and
# cgroup delegation that GitHub-hosted runners do not provide, so a CI copy
# fails for reasons unrelated to the code under test. They live in
# `just smoke` (crux/dev/smoke.crux) and run locally.
#
# Tier gates:
#   dev     : lint, test-unit
#   testing : test-conformance, test-property, borrow-fixtures
#   release : prepush, coverage-check
#   main    : check-protocol-drift, lint-docs
#
# Every step uses shell::capture, NOT shell::exec. shell::exec ignores a
# non-zero exit code, so a failing gate or a failed git push used to sail
# through to the final log line and still report success. shell::capture
# fails the step, which fails the run.
#
# Run: crux run .crux/promote.crux
budget: { calls: 28 }

steps:
  # ============================================================
  # Tier 1: Dev (develop)
  # ============================================================
  - step: gate_lint
    handler: shell::capture
    args:
      cmd: "cargo xtask lint"

  - step: gate_test_unit
    handler: shell::capture
    args:
      cmd: "cargo xtask test-unit"

  - step: build_release_dev
    handler: shell::capture
    args:
      # The package is minibox-cli; `mbx` is the binary it emits, so -p mbx
      # does not resolve.
      cmd: "cargo build --release -p miniboxd -p minibox-cli"

  # ============================================================
  # Tier 2: Testing (staging)
  # ============================================================
  - step: gate_test_conformance
    handler: shell::capture
    args:
      cmd: "cargo xtask test-conformance"

  - step: gate_test_property
    handler: shell::capture
    args:
      cmd: "cargo xtask test-property"

  - step: gate_borrow_fixtures
    handler: shell::capture
    args:
      cmd: "cargo xtask borrow-fixtures"

  # ============================================================
  # Tier 3: Release
  # ============================================================
  - step: gate_prepush
    handler: shell::capture
    args:
      cmd: "cargo xtask prepush"

  - step: gate_coverage_check
    handler: shell::capture
    args:
      cmd: "cargo xtask coverage-check"

  # ============================================================
  # Tier 4: Main (PR only)
  # ============================================================
  - step: gate_check_protocol_drift
    handler: shell::capture
    args:
      cmd: "cargo xtask check-protocol-drift"

  - step: gate_lint_docs
    handler: shell::capture
    args:
      cmd: "cargo xtask lint-docs"

  # PR for protected main branch
  - step: pr_release_to_main
    handler: shell::capture
    args:
      cmd: |
        set -eu
        # A promotion with nothing to promote is a success, not an error.
        # `gh pr create` rejects this as "No commits between main and release",
        # which would otherwise fail the whole run.
        if git fetch --quiet origin main release 2>/dev/null; then :; fi
        if git show-ref --verify --quiet refs/remotes/origin/main; then
          if [ "$(git rev-list --count origin/main..origin/release)" = "0" ] 2>/dev/null; then
            echo "release has no commits ahead of main; nothing to promote"
            exit 0
          fi
        fi
        existing=$(gh pr list --base main --head release --state open --json number -q '.[0].number')
        if [ -n "$existing" ]; then
          echo "PR #$existing already open: release -> main"
        else
          gh pr create --base main --head release \
            --title "Promote release -> main" \
            --body "Automated promotion. All tiered gates passed."
        fi

  # Only reachable when every gate above passed, because shell::capture
  # fails the run on the first non-zero exit.
  - step: done
    handler: ctrl::log
    args:
      msg: "develop -> staging -> release pushed with all tiered gates; release -> main PR open"
