pipeline: minibox_snap_notify
# Detect new insta snapshot files after a nextest run and list them.
# Run: crux run .crux/snap-notify.crux
budget: { calls: 4 }

steps:
  - step: list_snaps
    handler: shell::exec
    args:
      cmd: "git ls-files --others --exclude-standard '**/*.snap.new'"

  - step: report
    handler: ctrl::log
    args:
      msg: "Pending snapshots:\n{{ steps.list_snaps.output.stdout }}"
