pipeline: minibox_ci_watch
# Check CI status after a push and surface any failures.
# Run: crux run .crux/ci-watch.crux
budget: { calls: 6 }

steps:
  - step: latest_run
    handler: shell::capture
    args:
      cmd: "gh run list --repo 89jobrien/minibox --branch $(git branch --show-current) --limit 1 --json databaseId,status,conclusion,name --jq '.[0]'"

  - step: log_status
    handler: ctrl::log
    args:
      msg: "CI run: {{ steps.latest_run.output.stdout }}"
