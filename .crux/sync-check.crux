pipeline: minibox_sync_check
# Pre-push divergence check against the current branch's upstream.
# Exits ERR if behind or diverged -- safe to push only when all steps OK.
#
# Run: crux run .crux/sync-check.crux
budget: { calls: 4 }

steps:
  - step: fetch
    handler: shell::capture
    args:
      cmd: "git fetch origin --quiet 2>&1 || true"

  - step: resolve_upstream
    handler: shell::capture
    args:
      cmd: >-
        UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null);
        if [ -z "$UPSTREAM" ]; then
          echo "no upstream configured for $(git branch --show-current)" >&2;
          exit 1;
        fi;
        echo "$UPSTREAM"

  - step: count_divergence
    handler: shell::capture
    args:
      cmd: >-
        UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u});
        AHEAD=$(git rev-list --count "$UPSTREAM"..HEAD);
        BEHIND=$(git rev-list --count HEAD.."$UPSTREAM");
        echo "{\"upstream\": \"$UPSTREAM\", \"ahead\": $AHEAD, \"behind\": $BEHIND}"

  - step: assert_safe_to_push
    handler: shell::capture
    args:
      cmd: >-
        UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u});
        BEHIND=$(git rev-list --count HEAD.."$UPSTREAM");
        AHEAD=$(git rev-list --count "$UPSTREAM"..HEAD);
        if [ "$BEHIND" -gt 0 ]; then
          echo "NOT SAFE: behind $UPSTREAM by $BEHIND commit(s), ahead by $AHEAD" >&2;
          git log --oneline HEAD.."$UPSTREAM" | head -10 >&2;
          exit 1;
        fi;
        echo "SAFE: ahead of $UPSTREAM by $AHEAD commit(s), not behind"

  - step: summary
    handler: ctrl::log
